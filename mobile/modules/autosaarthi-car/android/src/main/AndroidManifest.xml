<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application>
    <!-- Android Auto reads this to learn the app has a car screen made of templates. -->
    <meta-data
        android:name="com.google.android.gms.car.application"
        android:resource="@xml/automotive_app_desc" />

    <!-- The category the car screen is built for (IOT needs car API level 6): the car is the
         connected device, and the one thing the driver can do about it is book its service. -->
    <meta-data
        android:name="androidx.car.app.minCarApiLevel"
        android:value="6" />

    <service
        android:name=".AutoSaarthiCarService"
        android:exported="true">
      <intent-filter>
        <action android:name="androidx.car.app.CarAppService" />
        <category android:name="androidx.car.app.category.IOT" />
      </intent-filter>
    </service>
  </application>
</manifest>
