# ── LLM (both free, no credit card) ───────────────────────────────────────
GROQ_API_KEY=gsk_xxx                 # console.groq.com  — primary, ~300 tok/s
GOOGLE_API_KEY=AIza_xxx              # aistudio.google.com — failover on 429
LLM_PRIMARY=llama-3.3-70b-versatile
LLM_FAST=llama-3.1-8b-instant
LLM_FALLBACK=gemini-2.5-flash

# ── infra ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://autosaarthi:autosaarthi@localhost:5432/autosaarthi
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=fleet
CHROMA_PATH=./data/chroma

# ── demo controls ─────────────────────────────────────────────────────────
DEMO_MODE=1                          # deterministic LLM responses from fixtures
SIM_SPEED=43200                      # 1 real second = 12 simulated hours
PRERENDERED_AUDIO=1                  # play demo/audio/*.wav instead of live TTS

# ── ueba ──────────────────────────────────────────────────────────────────
UEBA_ENABLED=1
UEBA_POLICY_PATH=./config/agent_policy.yaml
UEBA_AUDIT_PATH=./data/audit/agent_audit.jsonl

# ── auth ──────────────────────────────────────────────────────────────────
# development | production. Production REFUSES TO START on an unsafe default (no
# JWT_SECRET, no MFA_ENCRYPTION_KEY) and refuses to seed the demo accounts.
ENVIRONMENT=development

# Signs session tokens. REQUIRED in production; at least 32 characters.
# In development, unset is fine: the app generates a random key and keeps it in
# data/.jwt_dev_key (git-ignored) so restarts do not log everyone out.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Second factor (authenticator app). Roles marked mfa_required in
# config/access_policy.yaml must have one once this is 1; off by default so a fresh
# checkout is not blocked by something nobody has set up.
MFA_ENFORCEMENT=0
# Encrypts TOTP secrets at rest. REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset in development: derived from JWT_SECRET (rotating JWT_SECRET then orphans users).
MFA_ENCRYPTION_KEY=

# Sign in with Google. Empty = the button is not offered. Create an OAuth "Web
# application" client at console.cloud.google.com and register your origin under
# "Authorized JavaScript origins". Google accepts http://localhost but NOT a raw IP such
# as http://192.168.x.x — so this cannot work from a phone on the LAN without HTTPS.
GOOGLE_CLIENT_ID=

# Sign in with a phone number + one-time code (vehicle owners only).
#   console = print the code in the server log (development; refused in production)
#   twilio  = send a real SMS      none = phone sign-in off
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                          # a number, or a Messaging Service SID (MG...)
# In India the operator must have this exact text registered (TRAI DLT) or the SMS is
# silently dropped. {code} is required; {minutes} is optional.
# OTP_SMS_TEMPLATE=Your AutoSaarthi verification code is {code}. It expires in {minutes} minutes. Do not share this code with anyone.

# ── cors ──────────────────────────────────────────────────────────────────
# Comma-separated. Add the deployed frontend's real origin here — do not edit
# app/main.py to add an environment's origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
